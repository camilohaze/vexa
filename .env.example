# === Compartido ===
NODE_ENV=development
REDIS_URL=redis://localhost:6379

# === api-gateway (puerto 3000) ===
PORT=3000
DATABASE_URL=postgresql://vexa:vexa@localhost:5432/vexa
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true

# Correo transaccional (OTP, recibos): log | resend | sendgrid
MAIL_PROVIDER=log
MAIL_API_KEY=
MAIL_FROM=Vexa <no-reply@vexa.app>

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OAUTH_CALLBACK_BASE_URL=http://localhost:3000/api/auth
WEB_LANDING_URL=http://localhost:4400
WEB_COMPANY_URL=http://localhost:4200
WEB_ADMIN_URL=http://localhost:4300
WEB_COURIER_URL=http://localhost:4401
MOBILE_DEEP_LINK=vexa://auth/callback
CORS_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:4400,http://localhost:4401

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (https://developer.apple.com/account/resources/identifiers/list/serviceIdId)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Clave privada .p8 de Apple completa, con saltos de línea reales o \n escapados
APPLE_PRIVATE_KEY=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vexa
R2_PUBLIC_URL=

# Mapbox Directions API (ruta real + tráfico para price-estimate). Sin token, cae a estimado por línea recta.
MAPBOX_TOKEN=

# Firebase Cloud Messaging (JSON de la cuenta de servicio, en una línea)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Wompi (sandbox: https://sandbox.wompi.co)
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# === realtime-service (puerto 3001) ===
# PORT=3001

# === matching-service (puerto 3002) ===
# PORT=3002
MATCHING_RADIUS_METERS=3000
MATCHING_MAX_CANDIDATES=10
MATCHING_OFFER_TTL_SECONDS=45

# === Observabilidad (OpenTelemetry) ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME se define por servicio en main.ts
